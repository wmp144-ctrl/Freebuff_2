{
  "name": "netping-monitor",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "NetWatch - آفلاین مانیتورینگ تجهیزات شبکه (Ping Monitoring, Alerts, Reports, Maintenance, Map)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node server/index.js --dev",
    "start": "node server/index.js",
    "engine": "node server/engine-cli.js",
    "build": "vite build --config web/vite.config.ts",
    "preview": "node server/index.js",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test:unit && npm run test:web && npm run test:integration && npm run test:e2e",
    "test": "npm run test:unit && npm run test:web && npm run test:integration && npm run test:e2e",
    "test:unit": "node --test server/tests/unit/*.test.mjs",
    "test:web": "node --experimental-strip-types --test web/tests/*.test.ts",
    "test:db": "node --test server/tests/unit/db-*.test.mjs server/tests/unit/retention-*.test.mjs server/tests/unit/clock.test.mjs server/tests/integration/db-stability.test.mjs server/tests/integration/retention-api.test.mjs",
    "test:engine": "node --test server/tests/unit/leader.test.mjs server/tests/unit/engine-*.test.mjs server/tests/integration/engine-*.test.mjs",
    "test:integration": "node --experimental-strip-types --test server/tests/integration/*.test.mjs",
    "test:e2e": "node server/tests/smoke.mjs && node --test server/tests/e2e/*.test.mjs",
    "test:ui": "playwright test",
    "test:heavy": "node --experimental-strip-types --test server/tests/heavy/*.test.mjs",
    "qa:load": "node server/scripts/qa-load-matrix.mjs",
    "qa:soak": "node server/scripts/qa-soak.mjs",
    "qa:soak24": "node server/scripts/qa-soak.mjs --minutes 1440 --devices 100 --interval 30",
    "qa:soak72": "node server/scripts/qa-soak.mjs --minutes 4320 --devices 100 --interval 30",
    "release:prepare": "node server/scripts/release-prepare.mjs",
    "release:artifact": "node server/scripts/release-artifact.mjs",
    "seed:reset": "node server/scripts/reset-demo.js",
    "db:backup": "node server/scripts/db-backup.mjs",
    "db:restore": "node server/scripts/db-restore.mjs",
    "db:doctor": "node server/scripts/db-doctor.mjs",
    "db:retention": "node server/scripts/db-retention.mjs",
    "db:scale": "node server/scripts/qa-db-scale.mjs",
    "tls:setup": "node server/scripts/tls-setup.mjs",
    "load": "node server/scripts/load-test.mjs"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@node-rs/argon2": "^2.2.2",
    "@xyflow/react": "^12.12.0",
    "bidi-js": "^1.1.0",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^6.14.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/vazirmatn": "^5.1.0",
    "@playwright/test": "1.55.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}

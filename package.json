{
  "name": "netping-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NetWatch - آفلاین مانیتورینگ تجهیزات شبکه (Ping Monitoring, Alerts, Reports, Maintenance, Map)",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node server/index.js --dev",
    "start": "node server/index.js",
    "engine": "node server/engine-cli.js",
    "build": "vite build --config web/vite.config.ts",
    "preview": "node server/index.js",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "seed:reset": "node server/scripts/reset-demo.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@fontsource/vazirmatn": "^5.1.0",
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
